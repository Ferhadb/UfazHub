# Env consumed by docker compose at the project root (copy to `.env`):
#   cp deploy.env.example .env
POSTGRES_USER=ufaz
POSTGRES_DB=ufazhub
POSTGRES_PASSWORD=change_me  # CHANGE IN PRODUCTION

# Daily database backups (see DEPLOYMENT.md → "Database backups"). Local dumps
# always land in ./backups/ (kept BACKUP_KEEP_DAYS days). Each dump is also
# sent to a Telegram chat once BACKUP_TELEGRAM_CHAT_ID is set — that chat keeps
# the full history, retrievable from any device even if this server is gone.
# The bot token is TELEGRAM_BOT_TOKEN from backend/.env. Get the chat id by
# messaging @userinfobot (or make the bot an admin of a private channel and use
# that channel's id, e.g. -100…).
BACKUP_TELEGRAM_CHAT_ID=
BACKUP_KEEP_DAYS=14

# The app configuration itself goes in backend/.env (full documented list:
# backend/.env.example). Compose injects DATABASE_URL and REDIS_URL from the
# values above.
