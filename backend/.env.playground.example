# ---------------------------------------------------------------------------
# LOCAL PLAYGROUND ONLY — copy to backend/.env.playground (gitignored).
# `make playground` / scripts/playground.sh does this automatically.
# Every value here wins over backend/.env; real integrations are blanked.
# ---------------------------------------------------------------------------
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5433/ufazhub_playground
REDIS_URL=redis://localhost:6379/1
JWT_SECRET_KEY=playground-only-secret-not-for-production-0123456789
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SITE_URL=http://localhost:3000
COOKIE_SECURE=false

# --- External integrations: deliberately disabled -------------------------
SMTP_USERNAME=
SMTP_PASSWORD=
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
