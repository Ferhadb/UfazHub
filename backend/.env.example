# ---------------------------------------------------------------------------
# UFAZ Hub backend configuration (pydantic-settings reads this file).
# Copy to backend/.env and adjust. Unknown keys are ignored.
# Compose injects DATABASE_URL and REDIS_URL; the one value you must set is
# JWT_SECRET_KEY (prod refuses to start with the default).
# ---------------------------------------------------------------------------

# --- Core ---
APP_ENV=development            # development | test | production
API_PREFIX=/api
SITE_URL=http://localhost      # public web URL (emails, feeds, sitemap)
DATABASE_URL=postgresql+asyncpg://ufaz:change_me@db:5432/ufazhub
REDIS_URL=redis://redis:6379/0
# JSON array of browser origins allowed to call the API with credentials.
CORS_ORIGINS=["http://localhost","http://localhost:3000"]
LOG_LEVEL=INFO
SENTRY_DSN=                    # empty = Sentry off

# --- Auth (slice 2) ---
JWT_SECRET_KEY=replace-with-64-random-chars
COOKIE_SECURE=false            # true in production (HTTPS only)
SIGNUP_ALLOWED_DOMAINS=        # e.g. ufaz.az — empty allows any email

# --- Email (verification, reset, digests) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=UFAZ Hub <noreply@ufazhub.xyz>

# --- Uploads ---
MEDIA_ROOT=media               # a Docker volume in production (/app/media)
MEDIA_SIGNING_KEY=             # HMAC key for signed media URLs; empty derives one from JWT_SECRET_KEY
MEDIA_URL_TTL_SECONDS=3600
UPLOAD_MAX_BYTES=10485760      # PDFs
IMAGE_MAX_BYTES=5242880

# --- Backups (off-site copy; chat id lives in the root .env) ---
TELEGRAM_BOT_TOKEN=
